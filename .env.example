# ─────────────────────────────────────────────────────────
#  FlowForge WhatsApp Agent — Environment Variables
#  Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────────

# ── Meta Model API (AI brain — dev.meta.ai) ───────────────
# Found in: dev.meta.ai → API Keys → Create API Key
META_MODEL_API_KEY=              # e.g. LLM_xxxxxxxxxxxxxxxx

# ── Meta / WhatsApp Cloud API (messaging) ─────────────────
# Found in: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=        # e.g. 123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=    # e.g. 987654321098765
WHATSAPP_ACCESS_TOKEN=           # Set locally from Meta; never commit an access token.
WHATSAPP_VERIFY_TOKEN=           # any secret word e.g. flowforge2024

# ── Meta Business AI Agent (set AFTER running POST /onboard) ─
# After first boot, the console prints your agent_id — paste it here
META_AGENT_ID=                   # e.g. 1234567890 (returned by onboarding API)

# ── App config ────────────────────────────────────────────
PORT=3000
WHATSAPP_PHONE_NUMBER_DISPLAY=062 822 7013
