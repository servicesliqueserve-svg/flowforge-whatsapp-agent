# ─────────────────────────────────────────────────────────
# FlowForge Consulting — Forge environment variables
# Copy to .env locally; store production values in the host's
# secret manager. Never commit real values.
# ─────────────────────────────────────────────────────────

# ── Meta Model API ────────────────────────────────────────
META_MODEL_API_KEY=

# ── WhatsApp Cloud API ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_PHONE_NUMBER_DISPLAY=062 822 7013

# ── Meta Business AI Agent onboarding ─────────────────────
# Disabled unless explicitly enabled and protected by a 32+ character token.
ONBOARDING_ENABLED=false
ONBOARDING_ADMIN_TOKEN=

# ── Website security ──────────────────────────────────────
# Comma-separated exact origins; localhost only belongs in local development.
CORS_ALLOWED_ORIGINS=https://flowforgei.co.za,https://www.flowforgei.co.za

# ── Application ───────────────────────────────────────────
PORT=3000
